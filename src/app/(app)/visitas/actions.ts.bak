'use server'

import { revalidatePath } from 'next/cache'
import { redirect } from 'next/navigation'
import { requireModule } from '@/lib/auth'
import { toMsg } from '@/lib/format'
import { getSettings } from '@/lib/settings'

export const ESTADOS_VISITA = ['solicitud_recibida', 'pago_pendiente', 'pago_recibido', 'pendiente_agendamiento', 'visita_agendada', 'visita_confirmada', 'visita_realizada', 'cotizacion_generada', 'descontada_de_cotizacion', 'servicio_no_contratado', 'cancelada']
const SIN_PAGO = ['solicitud_recibida', 'pago_pendiente', 'cancelada']
const METODOS = ['efectivo', 'transferencia', 'nequi', 'daviplata', 'tarjeta', 'otro']

const fail = (id: string, m: string): never => redirect(`/visitas/${id}?error=` + toMsg(m))
const hoy = () => new Date().toLocaleDateString('en-CA', { timeZone: 'America/Bogota' })

export async function createVisit(fd: FormData) {
  const { supabase } = await requireModule('visitas')
  const clientId = String(fd.get('client_id') ?? '')
  if (!clientId) redirect('/visitas/nueva?error=' + toMsg('Elige un cliente'))
  const st = await getSettings(supabase)
  const { data, error } = await supabase.from('visits').insert({
    client_id: clientId, status: 'pago_pendiente', price: st.visit_price,
    notes: String(fd.get('notes') ?? '').trim() || null,
  }).select('id').single()
  if (error || !data) redirect('/visitas/nueva?error=' + toMsg('No se pudo crear la visita: ' + (error?.message ?? '')))
  redirect(`/visitas/${data.id}`)
}

export async function payVisit(fd: FormData) {
  const { supabase, profile } = await requireModule('visitas')
  const id = String(fd.get('id'))
  const method = String(fd.get('method') ?? '')
  if (!METODOS.includes(method)) fail(id, 'Elige el método de pago')
  const { data: v } = await supabase.from('visits').select('price,paid_at').eq('id', id).single()
  if (!v) fail(id, 'No se encontró la visita')
  if (v.paid_at) fail(id, 'Esta visita ya está pagada')
  const { error } = await supabase.from('visits').update({
    paid_amount: v.price, paid_at: hoy(), payment_method: method, payment_verified_by: profile.id, status: 'pago_recibido',
  }).eq('id', id)
  if (error) fail(id, 'No se pudo registrar el pago: ' + error.message)
  revalidatePath(`/visitas/${id}`)
  redirect(`/visitas/${id}`)
}

export async function scheduleVisit(fd: FormData) {
  const { supabase } = await requireModule('visitas')
  const id = String(fd.get('id'))
  const when = String(fd.get('scheduled_at') ?? '')
  if (!when) fail(id, 'Indica la fecha y hora')
  const { data: v } = await supabase.from('visits').select('paid_at').eq('id', id).single()
  if (!v?.paid_at) fail(id, 'Registra el pago antes de agendar')
  const { error } = await supabase.from('visits').update({
    scheduled_at: new Date(when + ':00-05:00').toISOString(), status: 'visita_agendada',
  }).eq('id', id)
  if (error) fail(id, 'No se pudo agendar: ' + error.message)
  redirect(`/visitas/${id}`)
}

export async function setVisitStatus(fd: FormData) {
  const { supabase } = await requireModule('visitas')
  const id = String(fd.get('id'))
  const status = String(fd.get('status') ?? '')
  if (!ESTADOS_VISITA.includes(status)) fail(id, 'Estado no válido')
  const { data: v } = await supabase.from('visits').select('paid_at').eq('id', id).single()
  if (!v) fail(id, 'No se encontró la visita')
  if (!SIN_PAGO.includes(status) && !v.paid_at) fail(id, 'Registra el pago antes de avanzar a ese estado')
  const { error } = await supabase.from('visits').update({ status }).eq('id', id)
  if (error) fail(id, 'No se pudo cambiar el estado: ' + error.message)
  revalidatePath(`/visitas/${id}`)
  redirect(`/visitas/${id}`)
}